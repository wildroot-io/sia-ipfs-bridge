# Copy to deploy/.env. Nothing here is a default worth shipping.

# The public https origin this gateway answers on. It goes into every
# delegated-routing record, so it must be reachable from outside.
ORIGIN=https://example.com

# The indexer. The admin API stays on the container network or loopback.
INDEXD_APP_URL=https://indexer.example.com
INDEXD_IMAGE=your/indexd:tag
POSTGRES_PASSWORD=

# Generated ONCE with `openssl rand -hex 32`, then never changed: the service's
# Sia app key derives from it, so a new id is a new account holding none of
# your pins. Not a secret — the indexer shows it at approval.
APP_ID=
APP_NAME=sia-ipfs-bridge

# The default single-owner bearer token. `openssl rand -hex 32`.
# Leave empty to refuse every write while you wire up your own accounts.
BRIDGE_TOKEN=

# The DHT swarm port. Must be reachable: a peer nobody can dial provides
# nothing.
PROVIDER_PORT=4001

# Block cache budgets, in bytes. RAM for the recent, disk for the popular.
CACHE_MEMORY_BYTES=536870912
CACHE_BYTES=10737418240
